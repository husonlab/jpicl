BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetworkView';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'Rotate0Deg',
	Rooting = 'None',
	ZoomFactor = 0.77204796,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]
